<?xml version="1.0" encoding="utf-8"?>
<!--
  Ejemplo de cadena de conexion. Este archivo SI se sube a git.
  La real va en connectionStrings.config (misma carpeta), que git ignora:
  el primer build la crea copiando este ejemplo. Para el hosting se usa
  connectionStrings.hosting.config (ver PUBLICAR-HOSTING.md) y nunca se sube.
-->
<connectionStrings>
  <add name="CatalogoDB"
       connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=CATALOGO2025;Integrated Security=True"
       providerName="System.Data.SqlClient" />
</connectionStrings>
